{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "teamcreator-mvp",
  "main": "live-worker.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [{ "name": "AI_LIMITER", "namespace_id": "1", "simple": { "limit": 6, "period": 60 } }],
  "assets": {
    "directory": "./dist-live",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
